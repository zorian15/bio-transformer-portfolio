# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Environments
.venv/
venv/
.env

# Notebooks
.ipynb_checkpoints/

# Data (tracked README only)
data/*
!data/README.md

# Model artifacts / experiment outputs
*.pt
*.ckpt
*.safetensors
weights/
checkpoints/
outputs/
wandb/
runs/

# Built docs site (regenerated by `mkdocs build`; deployed from CI)
site/

# Caches / tooling
.ruff_cache/
.mypy_cache/
.pytest_cache/

# OS
.DS_Store

# Run logs and manifests (regenerable; provenance for committed metrics is
# copied into each project results/ dir)
logs/

# Coverage artifacts, written by pytest-cov.
.coverage
.coverage.*
coverage.xml
htmlcov/

# Per-task result shards from the SLURM array. One file per configuration,
# 324 of them for rung 3; `--aggregate` combines them into <rung>.csv, which
# is the tracked artifact. The shards are intermediates.
*_shards/

# SLURM stdout/stderr. The directory is tracked (see slurm-logs/.gitkeep)
# because SLURM will not create it and a job whose --output path is missing
# produces no output at all.
slurm-logs/*
!slurm-logs/.gitkeep
